{
  "name": "handoff-diff-tool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:ui": "vite build",
    "build:plugin": "vite build --mode plugin",
    "build": "npm run build:ui && npm run build:plugin",
    "dev": "concurrently \"npm run build:ui -- --watch\" \"npm run build:plugin -- --watch\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.101.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.0"
  }
}
